ALLOWED_EMAIL=tu-correo@ejemplo.com
JWT_SECRET=genera-un-secreto-largo-y-aleatorio
# Local/desarrollo: sqlite:///./dev.db
# Producción en Render (disco efímero, NO uses sqlite ahí): cadena de
# conexión de Postgres, p.ej. de neon.tech: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./dev.db
RESEND_API_KEY=
# Opcional: remitente verificado en Resend (si no lo pones, usa el
# remitente de pruebas onboarding@resend.dev, que solo llega al correo
# del propio dueño de la cuenta de Resend).
EMAIL_FROM=Matlab_app <onboarding@resend.dev>
